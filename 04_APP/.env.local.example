# Supabase (contas, créditos e mapas salvos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role) — nunca expor no navegador
SUPABASE_SERVICE_ROLE_KEY=

# IAs
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# opcional: trocar o modelo de imagem do Gemini
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Login com Google (só depois de ativar o Google no Supabase)
NEXT_PUBLIC_GOOGLE_LOGIN=false

# Kiwify: link de checkout de cada plano e token do webhook
NEXT_PUBLIC_KIWIFY_ESSENCIAL=
NEXT_PUBLIC_KIWIFY_FLUENTE=
NEXT_PUBLIC_KIWIFY_PROFESSOR=
KIWIFY_WEBHOOK_TOKEN=
